# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) and edit.
# Every value has a working default for local demos; set real secrets anywhere else.

POSTGRES_DB=docviewer
POSTGRES_USER=docviewer
POSTGRES_PASSWORD=change-me

# Salt for hashing VINs in the audit table (D-011). Use a long random value outside local demos.
VIN_HASH_SALT=change-me-to-a-long-random-value

# Development enables the Scalar API UI at /scalar.
ASPNETCORE_ENVIRONMENT=Production

# Leave unset to send traces to the Jaeger container (obs profile).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

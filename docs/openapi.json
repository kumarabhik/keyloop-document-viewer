{
  "openapi": "3.1.1",
  "info": {
    "title": "Unified Document Viewer API",
    "description": "One VIN search across the dealership's Sales and Service systems. Every document names its source; a failing source makes the response partial (200), never an error.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/vehicles/{vin}/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Documents for a vehicle from all source systems",
        "description": "Calls the Sales and Service systems in parallel and returns one merged list. Each document names its source. If a source fails, the response is still 200 with partial=true; 503 only when no source answered and no snapshot exists. When auth is enabled (off by default), a bearer token is required and only documents of the token's dealer_id dealerships are returned; refresh=true then needs the admin role.",
        "operationId": "GetVehicleDocuments",
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "description": "17-character VIN; case-insensitive, surrounding spaces ignored. Letters I, O and Q are not allowed.",
            "required": true,
            "schema": {
              "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Only these sources: SALES, SERVICE. Repeat or comma-separate.",
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "SALES",
                  "SERVICE"
                ],
                "type": "string"
              }
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Only these types, e.g. INSURANCE, PUC, JOB_CARD. Repeat or comma-separate.",
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "INVOICE",
                  "RC",
                  "INSURANCE",
                  "PUC",
                  "WARRANTY",
                  "JOB_CARD",
                  "SERVICE_HISTORY",
                  "OTHER"
                ],
                "type": "string"
              }
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Only these statuses: VALID, EXPIRING_SOON, EXPIRED, NOT_APPLICABLE.",
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "NOT_APPLICABLE",
                  "VALID",
                  "EXPIRING_SOON",
                  "EXPIRED"
                ],
                "type": "string"
              }
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "description": "true skips the cache read; a complete result is still cached.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Optional page size, 1-100. Without it the whole list is returned (D-031).",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The nextCursor of the previous page, unchanged. Only meaningful with the same filters.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { },
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/sources/health": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Circuit-breaker state and last observed outcome per source",
        "operationId": "GetSourceHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceHealthResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { },
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CacheStatus": {
        "enum": [
          "HIT",
          "MISS",
          "BYPASS"
        ]
      },
      "CircuitState": {
        "enum": [
          "closed",
          "half_open",
          "open",
          "isolated"
        ]
      },
      "DocumentMarker": {
        "enum": [
          "POSSIBLE_DUPLICATE",
          "CONFLICT",
          "STALE"
        ]
      },
      "DocumentResponse": {
        "required": [
          "id",
          "sourceId",
          "vin",
          "title",
          "type",
          "date",
          "expiryDate",
          "source",
          "status",
          "flags",
          "metadata",
          "dealerCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "vin": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "source": {
            "$ref": "#/components/schemas/SourceSystem"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "flags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentMarker"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "dealerCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "Dealership the document belongs to; null when the source system did not say (D-034)."
          }
        }
      },
      "DocumentsResponse": {
        "required": [
          "vin",
          "partial",
          "generatedAt",
          "cache",
          "traceId",
          "sources",
          "summary",
          "documents",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "vin": {
            "type": "string"
          },
          "partial": {
            "type": "boolean",
            "description": "True when at least one source is not `ok`. The documents are then incomplete or partly stale: check `sources[].status` and show the user which system is missing or out of date. Still HTTP 200."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "cache": {
            "$ref": "#/components/schemas/CacheStatus"
          },
          "traceId": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatusResponse"
            }
          },
          "summary": {
            "description": "Counts over every document that matches the filters, on all pages together.",
            "$ref": "#/components/schemas/DocumentSummary"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentResponse"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "Pass as `cursor` (with the same filters and `limit`) to get the next page. Null on the last page and whenever `limit` is not set (D-031)."
          }
        }
      },
      "DocumentStatus": {
        "enum": [
          "NOT_APPLICABLE",
          "VALID",
          "EXPIRING_SOON",
          "EXPIRED"
        ]
      },
      "DocumentSummary": {
        "required": [
          "total",
          "expired",
          "expiringSoon",
          "duplicates",
          "conflicts"
        ],
        "type": "object",
        "properties": {
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "expired": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "expiringSoon": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "duplicates": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "conflicts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "DocumentType": {
        "enum": [
          "INVOICE",
          "RC",
          "INSURANCE",
          "PUC",
          "WARRANTY",
          "JOB_CARD",
          "SERVICE_HISTORY",
          "OTHER"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SourceHealthResponse": {
        "required": [
          "name",
          "circuit",
          "lastStatus",
          "lastLatencyMs",
          "lastCheckedAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/SourceSystem"
          },
          "circuit": {
            "$ref": "#/components/schemas/CircuitState"
          },
          "lastStatus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceStatus"
              }
            ]
          },
          "lastLatencyMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "lastCheckedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SourceStatus": {
        "enum": [
          "ok",
          "stale",
          "timeout",
          "error",
          "circuit_open"
        ]
      },
      "SourceStatusResponse": {
        "required": [
          "name",
          "status",
          "latencyMs",
          "count",
          "asOf"
        ],
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/SourceSystem"
          },
          "status": {
            "description": "`ok`: this source answered. `stale`: it failed, and its documents come from the last saved copy (see `asOf`). `timeout`, `error`, `circuit_open`: it failed and none of its documents are in this response.",
            "$ref": "#/components/schemas/SourceStatus"
          },
          "latencyMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "asOf": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the saved copy was taken; set only when `status` is `stale`. Copies older than 24 h (default) are never served.",
            "format": "date-time"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SourceSystem": {
        "enum": [
          "SALES",
          "SERVICE"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Only when the API runs with Auth:Enabled=true (off by default): an OIDC access token whose dealer_id claims name the dealerships whose documents may be returned (D-034).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Documents"
    }
  ]
}
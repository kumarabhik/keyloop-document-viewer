@* D5.2: circuit state and last outcome per source, plus demo switches for the mock systems' fault modes. *@
@implements IDisposable
@inject DocumentsApiClient Api
@inject TimeProvider Time

<details class="health" data-health open="@Open">
    <summary>Source health</summary>

    @if (_health is null)
    {
        <p class="health__note" data-health-state="@(_loaded ? "unreachable" : "loading")">
            @(_loaded ? "The API's health endpoint cannot be reached." : "Loading…")
        </p>
    }
    else
    {
        <table class="health__table">
            <thead>
                <tr><th scope="col">System</th><th scope="col">Circuit</th><th scope="col">Last call</th><th scope="col">Latency</th><th scope="col">Checked</th><th scope="col">Demo: make it fail</th></tr>
            </thead>
            <tbody>
                @foreach (var source in _health)
                {
                    <tr data-health-source="@source.Name">
                        <td><SourceBadge Source="@source.Name" /></td>
                        <td><span class="circuit circuit--@CircuitClass(source.Circuit)" title="@CircuitHelp(source.Circuit)">@CircuitLabel(source.Circuit)</span></td>
                        <td>@(source.LastStatus ?? "not called yet")</td>
                        <td>@(source.LastLatencyMs is { } ms ? $"{ms} ms" : "—")</td>
                        <td>@(source.LastCheckedAt is { } at ? Format.Timestamp(at, Time) : "—")</td>
                        <td>
                            <select @key="@($"{source.Name}-{_redraw}")" data-fault="@source.Name" aria-label="Fault mode for @WireValues.Label(source.Name)"
                                    value="@ModeOf(source.Name)" @onchange="e => SetFaultAsync(source.Name, e.Value?.ToString() ?? Healthy)">
                                @foreach (var (mode, label) in FaultModes)
                                {
                                    <option value="@mode">@label</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_message is not null)
    {
        <p class="health__note" data-health-message>@_message</p>
    }
    <p class="health__note">The fault switches call the mock systems' <code>/__admin/fault</code>; search again to see the effect.</p>
</details>

@code {
    private const string Healthy = "none";

    private static readonly (string Mode, string Label)[] FaultModes =
    [
        (Healthy, "Healthy"),
        ("timeout", "Hang (timeout)"),
        ("slow", "Slow"),
        ("error", "HTTP 500"),
        ("flaky", "Flaky"),
        ("malformed", "Malformed JSON"),
    ];

    private readonly CancellationTokenSource _cts = new();
    private readonly Dictionary<string, string> _modes = [];
    private IReadOnlyList<SourceHealthResponse>? _health;
    private bool _loaded;
    private int _redraw; // bumped to reset a select whose change the mock refused
    private string? _message;
    private int _lastRefreshKey = -1;

    /// <summary>Change it (e.g. after each search) to reload the panel.</summary>
    [Parameter]
    public int RefreshKey { get; set; }

    [Parameter]
    public bool Open { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (RefreshKey != _lastRefreshKey)
        {
            _lastRefreshKey = RefreshKey;
            await LoadAsync();
        }
    }

    private string ModeOf(string source) => _modes.GetValueOrDefault(source, Healthy);

    private async Task LoadAsync()
    {
        _health = await Api.GetSourceHealthAsync(_cts.Token);
        foreach (var source in WireValues.SourceNames)
        {
            // Show what the mock is really doing (k6, curl or another tab may have changed it).
            if (await Api.GetFaultAsync(source, _cts.Token) is { } mode)
            {
                _modes[source] = mode;
            }
        }

        _loaded = true;
    }

    private async Task SetFaultAsync(string source, string mode)
    {
        var ok = await Api.SetFaultAsync(source, mode, _cts.Token);
        if (ok)
        {
            _modes[source] = mode;
        }
        else
        {
            _redraw++; // put the select back to the mode the mock still has
        }

        _message = ok
            ? $"{Format.SourceName(source)} set to \"{FaultModes.First(f => f.Mode == mode).Label}\"."
            : $"Could not reach the {Format.SourceName(source)} mock. The switches work only with the local mock systems.";
        await LoadAsync();
    }

    private static string CircuitClass(string circuit) => circuit switch
    {
        "closed" => "closed",
        "half_open" => "half-open",
        _ => "open",
    };

    private static string CircuitLabel(string circuit) => circuit switch
    {
        "closed" => "Closed (calls flow)",
        "half_open" => "Half-open (testing)",
        "open" => "Open (calls paused)",
        _ => circuit,
    };

    private static string CircuitHelp(string circuit) => circuit switch
    {
        "open" => "After repeated failures the API stops calling this system for 30 s and answers at once instead of waiting.",
        "half_open" => "The API is letting one trial call through to see whether the system has recovered.",
        _ => "Normal: every search calls this system.",
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
